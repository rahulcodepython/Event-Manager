# Local reverse proxy. In production replace :80 with the app's domain and
# point the sites block at the real sites domain (e.g. *.identitycard.events).

{
    # Event sites get certificates on demand, only for slugs that exist.
    on_demand_tls {
        ask http://127.0.0.1:8002/__tls-check
    }
}

:80 {
    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        reverse_proxy 127.0.0.1:3000
    }
}

# Uploaded event sites (cmd/sites), on a domain separate from the app.
# Production: replace with "*.identitycard.events" and keep "tls { on_demand }".
http://*.sites.localhost {
    reverse_proxy 127.0.0.1:8002
}
