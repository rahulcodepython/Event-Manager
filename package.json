{
    "name": "identity-card",
    "version": "0.0.1",
    "private": true,
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "dev": "bun run docker:up && bun run migrate:up && bun --filter '*' dev",
        "docker:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
        "docker:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
        "docker:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f",
        "dev:web": "bun --filter web dev",
        "dev:server": "bun --filter server dev",
        "format": "bun --filter web format",
        "typecheck": "bun --filter web typecheck && bun --filter admin typecheck && bun --filter landing typecheck",
        "seed": "bun --filter server seed",
        "seeds:regenerate": "bun --filter server seeds:regenerate",
        "flush": "bun --filter server flush",
        "migrate:up": "bun --filter server migrate:up",
        "migrate:down": "bun --filter server migrate:down",
        "migrate:new": "bun --filter server migrate:new",
        "migrate:force": "bun --filter server migrate:force",
        "dev:admin": "bun --filter server dev:admin",
        "dev:admin-web": "bun --filter admin dev",
        "dev:sites": "bun --filter server dev:sites",
        "dev:landing": "bun --filter landing dev"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2"
    }
}
