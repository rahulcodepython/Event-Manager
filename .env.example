# =====================================================================
# IdentityCard — single env file for the whole repo.
# Copy to `.env` at the repo root. apps/server, apps/web and infra all
# read this one file. ${VAR} references are expanded.
# =====================================================================

# ---------- App ----------
# development | production
APP_ENV=development

# ---------- Ports & URLs ----------
# client API (apps/server cmd/server)
API_PORT=8000
# admin API (apps/server cmd/admin)
ADMIN_API_PORT=8001
# public URL of the client API
API_URL=http://localhost:${API_PORT}
# client web app (apps/web)
WEB_URL=http://localhost:3000
# admin web app
ADMIN_WEB_URL=http://localhost:3001
# marketing site (apps/landing)
LANDING_URL=http://localhost:3002

# Browser-visible copies for the web apps (Next.js only exposes NEXT_PUBLIC_*)
NEXT_PUBLIC_API_BASE_URL=${API_URL}
NEXT_PUBLIC_WEB_URL=${WEB_URL}
# Country list for phone inputs (apps/web)
NEXT_PUBLIC_COUNTRIES_API_URL=https://restcountries.com/v3.1
ADMIN_API_URL=http://localhost:${ADMIN_API_PORT}
NEXT_PUBLIC_ADMIN_API_BASE_URL=${ADMIN_API_URL}

# ---------- Postgres ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=identitycard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=identitycard
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# ---------- Auth (JWT in httpOnly cookies) ----------
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---------- Sessions and abuse limits ----------
# Durations use Go syntax: 15m, 24h, 600ms.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=100
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW=15m
CONTACT_MAX_PER_HOUR=5
UPLOAD_MAX_PER_HOUR=30
UPLOAD_PENDING_TTL=24h
DEVICE_PIN_TTL=5m

# ---------- Platform admin (admin API + apps/admin) ----------
# Single admin account. Password: at least 12 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Separate from the client JWT secrets. Generate each with: openssl rand -base64 48
ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_REFRESH_SECRET=

# Google OAuth (organizer login). Register GOOGLE_REDIRECT_URL as an
# "Authorized redirect URI" on the OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=${API_URL}/api/v1/auth/google/callback
GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
# Applicant sign-in on the public form (planned, PLAN.md Phase 11). Register
# APPLICANT_GOOGLE_LOGIN_URI as an Authorized redirect URI and WEB_URL as an
# Authorized JavaScript origin on the same OAuth client.
APPLICANT_GOOGLE_LOGIN_URI=${API_URL}/api/v1/public/apply/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
APPLICANT_SESSION_TTL=24h
APPLICATION_SEAT_HOLD=15m
APPLICATION_DRAFT_TTL=168h

# ---------- WebAuthn (scanner devices) ----------
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_DISPLAY_NAME="IdentityCard Scanner"

# ---------- Payments: Razorpay ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
# Browser checkout script (apps/web)
NEXT_PUBLIC_RAZORPAY_CHECKOUT_URL=https://checkout.razorpay.com/v1/checkout.js
# Register this in the Razorpay dashboard (events: payment.captured, order.paid).
# Reference only: the API serves the webhook at this path on API_URL.
RAZORPAY_WEBHOOK_URL=${API_URL}/api/v1/payments/razorpay/webhook

# ---------- ID cards ----------
# HMAC key for the QR code on every card. Changing it invalidates all issued cards.
# Generate with: openssl rand -base64 48
QR_SIGNING_SECRET=

# ---------- Event sites (uploaded static sites on their own domain) ----------
# Sites are served by cmd/sites at <slug>.<SITES_DOMAIN>. Use a domain separate
# from the app so a site can never read the app's cookies. *.localhost
# resolves to 127.0.0.1 in browsers, so dev works without DNS.
SITES_PORT=8002
SITES_DOMAIN=sites.localhost
# Public base for links, e.g. https://{slug}.identitycard.events in production
SITES_URL_TEMPLATE=http://{slug}.sites.localhost:8002
NEXT_PUBLIC_SITES_URL_TEMPLATE=${SITES_URL_TEMPLATE}

# ---------- Storage: S3-compatible (MinIO locally, R2/S3 in production) ----------
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
S3_ENDPOINT=localhost:${MINIO_API_PORT}
S3_USE_SSL=false
S3_REGION=us-east-1
S3_BUCKET=identitycard
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- Email: Resend (ID cards, client reminders) ----------
# Landing page contact form messages go here (empty: stored only)
CONTACT_EMAIL=
RESEND_API_KEY=
EMAIL_FROM="IdentityCard <no-reply@example.com>"
RESEND_BASE_URL=https://api.resend.com
# Pause between emails (Resend allows 2 requests per second)
EMAIL_SEND_INTERVAL=600ms

# ---------- Seed (make seed) ----------
# Demo organization is owned by this Google account email.
SEED_CLIENT_EMAIL=
