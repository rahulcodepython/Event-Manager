APP_ENV=development
PORT=8000

DATABASE_URL=postgres://identitycard:identitycard@localhost:5432/identitycard?sslmode=disable

WEB_ORIGIN=http://localhost:3000

# Admin API (cmd/admin, `make dev-admin`) — own port, CORS allows the admin web UI
ADMIN_PORT=8001
ADMIN_WEB_ORIGIN=http://localhost:3001

# Redis for caching, rate limiting, and ephemeral state
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
