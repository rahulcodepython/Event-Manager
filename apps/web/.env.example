# Server-only: base URL of apps/server. Never expose this as NEXT_PUBLIC_ —
# all API calls happen from Server Components/Server Actions, never the browser.
API_BASE_URL=http://localhost:8000

# Public: this app's own origin, used to display the shareable public
# sign-up form link (e.g. `${NEXT_PUBLIC_APP_URL}/forms/<token>`).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public: same Go API as API_BASE_URL, but reachable from client-side JS.
# Used only by /pair and /scanner — a scanner-bot device authenticates
# with a key in localStorage, not a cookie, so it calls the API directly
# from the browser instead of through a Server Component/Action.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# better-auth now owns all user/org/session data — same Postgres instance
# the Go API uses (see apps/server/.env.example's DATABASE_URL), so both
# sides' migrations land in one database.
DATABASE_URL=postgres://identitycard:identitycard@localhost:5432/identitycard?sslmode=disable

# Run `openssl rand -base64 32` for a real value.
BETTER_AUTH_SECRET=dev-only-change-me
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — optional; the Google sign-in button 404s until these are
# filled in. Same Google Cloud OAuth client Go used to use.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
